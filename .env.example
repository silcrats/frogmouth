# Copy to .env and fill in. Values here are read by config.yaml via ${VAR}.

# --- OpenSearch -------------------------------------------------------
OS_HOST=https://opensearch:9200
SEARCH_INDEX=documents
# A read-only account. With Pelican: pelican-reader, whose password is
# OS_READER_PASSWORD in Pelican's .env.
OS_USERNAME=pelican-reader
OS_PASSWORD=
# Set in docker-compose.example.yml (Pelican's certs volume at /certs).
# OS_CA_CERTS=/certs/ca.pem
# Semantic and hybrid search, for an index built with Pelican's vector
# search (VECTOR_ENABLED=true in Pelican's .env too).
# VECTOR_ENABLED=true

# --- Sessions ---------------------------------------------------------
# Required: at least 32 characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
# Set to true when users reach Frogmouth over HTTPS.
SESSION_SECURE_COOKIE=false

# --- LDAP / Active Directory -----------------------------------------
LDAP_URL=ldap://dc01.example.local:389
# {username} is replaced with what the user types at sign-in.
LDAP_BIND_TEMPLATE={username}@example.local
LDAP_BASE_DN=DC=example,DC=local
LDAP_USERNAME_ATTR=sAMAccountName

# --- SMB downloads ----------------------------------------------------
# Default credential variables named in shares.yaml; a share entry may
# point at different ones via user_env / pass_env / domain_env.
SMB_USER=
SMB_PASS=
SMB_DOMAIN=

# --- Optional ---------------------------------------------------------
# PORT=3000
# CONFIG_PATH=/app/config.yaml
# SHARES_CONFIG=/app/shares.yaml
