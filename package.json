{
  "name": "frogmouth-search",
  "version": "0.9.0",
  "description": "Config-driven, LDAP-authenticated search UI for an OpenSearch index, with pluggable file downloads.",
  "license": "Apache-2.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=2 \"tests/unit/*.test.js\" \"tests/api/*.test.js\"",
    "test:browser": "node --test --test-concurrency=1 \"tests/browser/*.test.js\"",
    "test:all": "npm test && npm run test:browser"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-session": "^1.18.0",
    "js-yaml": "^5.5.0",
    "ldapjs": "^3.0.7",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "playwright-core": "^1"
  }
}
